{
  "apiVersion": 2,
  "id": "hello",
  "name": "Hello SDK",
  "version": "1.0.0",
  "runtime": "js",
  "entry": "bundle.js",
  "categories": ["all"],
  "providers": [
    {
      "id": "hello.catalog",
      "roles": ["catalog"],
      "catalogs": [
        {
          "id": "main",
          "name": "Hello",
          "categories": ["all"],
          "display": "grid"
        }
      ]
    },
    { "id": "hello.stream", "name": "Hello Stream", "roles": ["stream"] }
  ],
  "permissions": { "hosts": ["cdn.example.com"] }
}
